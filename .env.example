# Copy to .env and fill in real values. .env is gitignored.

# MySQL (WAMP default: root with empty password on 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dental

# Semaphore SMS (https://semaphore.co) — leave empty to disable notifications
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=DENTAL
